{
  "title": "Climate",
  "path": "climate",
  "type": "sections",
  "icon": "mdi:thermometer",
  "max_columns": 3,
  "badges": [
    {
      "type": "entity",
      "entity": "sensor.indoor_temperature",
      "name": "Indoors",
      "show_state": true,
      "color": "orange"
    },
    {
      "type": "entity",
      "entity": "sensor.house_temperature",
      "name": "Outside",
      "show_state": true,
      "color": "green"
    },
    {
      "type": "entity",
      "entity": "sensor.indoor_humidity",
      "name": "RH",
      "show_state": true,
      "color": "cyan"
    },
    {
      "type": "entity",
      "entity": "sensor.ac_power_total",
      "name": "AC load",
      "show_state": true,
      "color": "green"

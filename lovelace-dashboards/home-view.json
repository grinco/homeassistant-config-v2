          "icon": "mdi:air-filter",
          "secondary": "{{ {'1':'Good','2':'Fair','3':'Moderate','4':'Poor','5':'Very poor'}.get(states('sensor.outside_openweathermap_air_quality_index'), '—') }} · PM2.5 {{ states('sensor.outside_openweathermap_pm2_5') | float(0) | round(0) | int }}",
          "color": "{{ {'1':'green','2':'light-green','3':'amber','4':'orange','5':'red'}.get(states('sensor.outside_openweathermap_air_quality_index'), 'grey') }}",

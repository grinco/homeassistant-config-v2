          "hold_action": {
            "action": "navigate",
            "navigation_path": "/lovelace/security"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "features_position": "bottom"
        },
        {
          "type": "custom:mushroom-template-card",
          "vertical": true,
          "grid_options": {
            "columns": 4
          },
          "entity": "weather.house",
          "primary": "Outside",
          "icon": "{% set m = {'clear-night':'mdi:weather-night','cloudy':'mdi:weather-cloudy','fog':'mdi:weather-fog','hail':'mdi:weather-hail','lightning':'mdi:weather-lightning','lightning-rainy':'mdi:weather-lightning-rainy','partlycloudy':'mdi:weather-partly-cloudy','pouring':'mdi:weather-pouring','rainy':'mdi:weather-rainy','snowy':'mdi:weather-snowy','snowy-rainy':'mdi:weather-snowy-rainy','sunny':'mdi:weather-sunny','windy':'mdi:weather-windy','windy-variant':'mdi:weather-windy-variant'} %}{{ m.get(states('weather.house'), 'mdi:weather-cloudy') }}",
          "secondary": "{{ state_attr('weather.house','temperature') | float(0) | round(0) | int }}° · {{ states('sensor.house_precipitation_probability') }}% rain",
          "color": "{{ 'indigo' if is_state('sun.sun','below_horizon') else 'light-blue' }}",
          "tap_action": {
            "action": "more-info"
          },
          "hold_action": {
            "action": "navigate",
            "navigation_path": "/lovelace/climate"
          },
          "icon_tap_action": {
            "action": "more-info"
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "vertical": true,
          "grid_options": {
            "columns": 4
          },
          "entity": "sensor.outside_openweathermap_air_quality_index",

{
  "title": "Home",
  "path": "home",
  "type": "sections",
  "icon": "mdi:home",
  "max_columns": 3,
  "header": {
    "layout": "responsive",
    "badges_position": "bottom",
    "badges_wrap": "scroll",
    "card": {
      "type": "markdown",
      "text_only": true,
      "content": "{% set h = now().hour %}## {% if h < 5 %}Good night{% elif h < 12 %}Good morning{% elif h < 18 %}Good afternoon{% else %}Good evening{% endif %}\n{% set aps = ['light.lower_floor_led','light.closet_switch_led','light.garden_led','light.upper_floor_led'] %}{% set n = states.light | rejectattr('attributes.entity_id','defined') | rejectattr('entity_id','in',aps) | selectattr('state','eq','on') | list | count %}{{ n }} light{{ 's' if n != 1 }} on{% set ac = states.climate | rejectattr('state','eq','off') | list | count %}{% if ac %} · {{ ac }} AC running{% endif %}{% set nr = as_timestamp(states('sensor.sun_next_rising'), 0) %}{% set nd = as_timestamp(states('sensor.sun_next_setting'), 0) %}{% if nr and nd %} · {% if nr < nd %}sunrise {{ nr | timestamp_custom('%H:%M', true) }}{% else %}sunset {{ nd | timestamp_custom('%H:%M', true) }}{% endif %}{% endif %}"
    }
  },
  "badges": [
    {
      "type": "shortcut",
      "text": "Ask",
      "icon": "mdi:microphone-message",
      "color": "purple",
      "tap_action": {
        "action": "assist"
      }
    },
    {
      "type": "entity",
      "entity": "sensor.indoor_temperature",
      "name": "Indoors",
      "show_state": true,
      "color": "orange"
    },
    {
      "type": "entity",
      "entity": "sensor.indoor_humidity",
      "name": "RH",
      "show_state": true,
      "color": "cyan"
    },
    {
      "type": "entity",
      "entity": "person.adult1",
      "name": "Adult 1",
      "show_name": true,
      "show_state": false,
      "show_entity_picture": true,
      "color": "green"
    },
    {
      "type": "entity",
      "entity": "person.adult2",
      "name": "Adult 2",
      "show_name": true,
      "show_state": false,
      "show_entity_picture": true,
      "color": "green"
    },
    {
      "type": "entity",
      "entity": "person.kid1",
      "name": "Kids room 1",
      "show_name": true,
      "show_state": false,
      "show_entity_picture": true,
      "color": "green"
    }
  ],
  "sections": [
    {
      "type": "grid",
      "column_span": 2,
      "background": {
        "color": "red",
        "opacity": 12
      },
      "visibility": [
        {
          "condition": "or",
          "conditions": [
            {
              "condition": "state",
              "entity": "binary_sensor.shower_sink_leak_water_leak",
              "state": "on"
            },
            {
              "condition": "state",
              "entity": "binary_sensor.any_battery_low",
              "state": "on"
            },
            {
              "condition": "state",
              "entity": "alarm_control_panel.home",
              "state": "triggered"
            }
          ]
        }
      ],
      "cards": [
        {
          "type": "heading",
          "heading": "Needs attention",
          "icon": "mdi:alert-circle-outline"
        },
        {
          "type": "tile",
          "entity": "alarm_control_panel.home",
          "name": "Alarm triggered",
          "icon": "mdi:shield-alert",
          "color": "red",
          "grid_options": {
            "columns": 12
          },
          "features": [
            {
              "type": "alarm-modes",
              "modes": [
                "armed_home",
                "armed_away"
              ]
            }
          ],
          "visibility": [
            {
              "condition": "state",
              "entity": "alarm_control_panel.home",
              "state": "triggered"
            }
          ]
        },
        {
          "type": "tile",
          "entity": "binary_sensor.shower_sink_leak_water_leak",
          "name": "Water leak — shower sink",
          "icon": "mdi:water-alert",
          "color": "red",
          "grid_options": {
            "columns": 12
          },
          "visibility": [
            {
              "condition": "state",
              "entity": "binary_sensor.shower_sink_leak_water_leak",
              "state": "on"
            }
          ]
        },
        {
          "type": "markdown",
          "visibility": [
            {
              "condition": "state",
              "entity": "binary_sensor.any_battery_low",
              "state": "on"
            }
          ],
          "content": "{% set alias = {'0x0017880106495a81':'Outdoor motion, front door','0x1035970000139e5b':'IKEA BILRESA remote','0x5c0272fffeac2293':'IKEA motion sensor','0x8c65a3fffe350702':'Tuya smart knob','0x0ceff6fffe5e5be4':'SONOFF button'} %}{% set ns = namespace(low=[]) %}{%- for s in states.sensor | selectattr('attributes.device_class','defined') | selectattr('attributes.device_class','eq','battery') | rejectattr('entity_id','search','volvo') %}{%- if s.state not in ['unknown','unavailable'] and s.state | float(101) < 15 %}{%- set raw = s.name | replace(' Battery','') %}{%- set ns.low = ns.low + [(s.state | float(0), alias.get(raw, raw))] %}{%- endif %}{%- endfor %}**{{ ns.low | count }} low batter{{ 'ies' if ns.low | count != 1 else 'y' }}** — {% for pct, nm in ns.low | sort %}{{ nm }} {{ pct | round(0) }}%{{ ', ' if not loop.last }}{% endfor %}"
        },
        {
          "type": "markdown",
          "content": "{% set ns = namespace(mould=[], health=[], air=[]) %}{% set rooms = [('Living room','living_room'),('Office','office'),('Bedroom','bedroom'),('Kids room 1','kid1'),('Kids room 2','kid2')] %}{% for name, r in rooms %}{% set t = states('sensor.climate_temp_' ~ r) | float(-99) %}{% set h = states('sensor.climate_humidity_' ~ r) | float(-1) %}{% if t > -90 and h >= 0 %}{% set g = (17.27 * t / (237.7 + t)) + log(h / 100) %}{% set dp = 237.7 * g / (17.27 - g) %}{% set sp = t - dp %}{% if h >= 70 %}{% set ns.mould = ns.mould + ['**' ~ name ~ '** ' ~ h ~ '% RH — mould grows above 70%'] %}{% elif h >= 65 %}{% set ns.mould = ns.mould + ['**' ~ name ~ '** ' ~ h ~ '% RH — drifting toward mould territory'] %}{% endif %}{% if sp < 3 %}{% set ns.mould = ns.mould + ['**' ~ name ~ '** only ' ~ sp | round(1) ~ ' °C above its dew point — condensation on any cooler surface'] %}{% endif %}{% if h < 30 %}{% set ns.health = ns.health + ['**' ~ name ~ '** ' ~ h ~ '% RH — dry enough to irritate airways'] %}{% endif %}{% if t < 16 %}{% set ns.health = ns.health + ['**' ~ name ~ '** ' ~ t | round(1) ~ ' °C — cold enough to be a health risk, not just uncomfortable'] %}{% endif %}{% endif %}{% endfor %}{% for s in states.sensor | selectattr('attributes.device_class','defined') | selectattr('attributes.device_class','eq','carbon_dioxide') | list %}{% if s.state | float(0) >= 1400 %}{% set ns.air = ns.air + ['**' ~ s.name ~ '** ' ~ s.state ~ ' ppm CO₂ — ventilate'] %}{% elif s.state | float(0) >= 1000 %}{% set ns.air = ns.air + ['**' ~ s.name ~ '** ' ~ s.state ~ ' ppm CO₂ — stuffy'] %}{% endif %}{% endfor %}{% for s in states.sensor | selectattr('attributes.device_class','defined') | selectattr('attributes.device_class','eq','pm25') | rejectattr('entity_id','search','openweathermap') | list %}{% if s.state | float(0) >= 25 %}{% set ns.air = ns.air + ['**' ~ s.name ~ '** ' ~ s.state ~ ' µg/m³ PM2.5'] %}{% endif %}{% endfor %}{% set aqi = states('sensor.outside_openweathermap_air_quality_index') | int(0) %}{% if aqi >= 4 %}{% set ns.air = ns.air + ['Outdoor air quality **' ~ aqi ~ '/5** — keep windows shut; do not ventilate to cool'] %}{% endif %}{% if ns.mould %}🦠 **Damp / mould risk**\n{% for x in ns.mould %}- {{ x }}\n{% endfor %}\n{% endif %}{% if ns.health %}🫁 **Health**\n{% for x in ns.health %}- {{ x }}\n{% endfor %}\n{% endif %}{% if ns.air %}🌫️ **Air quality**\n{% for x in ns.air %}- {{ x }}\n{% endfor %}{% endif %}",
          "visibility": [
            {
              "condition": "state",
              "entity": "binary_sensor.climate_health_risk",
              "state": "on"
            }
          ]
        },
        {
          "type": "tile",
          "entity": "sensor.corridor_xiaomi_air_purifier_filter_life_remaining",
          "name": "Air purifier filter",
          "icon": "mdi:air-filter",
          "color": "orange",
          "visibility": [
            {
              "condition": "numeric_state",
              "entity": "sensor.corridor_xiaomi_air_purifier_filter_life_remaining",
              "below": 15
            }
          ]
        }
      ]
    },
    {
      "type": "grid",
      "column_span": 2,
      "cards": [
        {
          "type": "heading",
          "heading": "At a glance",
          "icon": "mdi:eye-outline"
        },
        {
          "type": "tile",
          "entity": "sensor.downstairs_temperature",
          "name": "Downstairs",

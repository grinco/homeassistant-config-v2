          "secondary": "{% set aps = ['light.lower_floor_led','light.closet_switch_led','light.garden_led','light.upper_floor_led'] %}{% set n = states.light | rejectattr('attributes.entity_id','defined') | rejectattr('entity_id','in',aps) | selectattr('state','eq','on') | list | count %}{{ n ~ ' on' if n else 'All off' }}",
          "color": "{% set aps = ['light.lower_floor_led','light.closet_switch_led','light.garden_led','light.upper_floor_led'] %}{% set n = states.light | rejectattr('attributes.entity_id','defined') | rejectattr('entity_id','in',aps) | selectattr('state','eq','on') | list | count %}{{ 'amber' if n else 'grey' }}",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "light.turn_off",
            "target": {
              "area_id": [
                "living_room",
                "kitchen",
                "bedroom",
                "corridor",
                "bedroom_2",
                "kid1_room",
                "kid2_room",
                "hallway",
                "bathroom",
                "shower",
                "laundry_room",
                "closet"
              ]
            },
            "confirmation": {
              "text": "Turn off every light in the house?"
            }
          },
          "icon_tap_action": {
            "action": "none"
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "vertical": true,
          "grid_options": {
            "columns": 4
          },
          "entity": "sensor.indoor_temperature",
          "primary": "Indoors",
          "icon": "mdi:home-thermometer",
          "secondary": "{{ states('sensor.indoor_temperature') | float(0) | round(1) }}° · {{ states('sensor.indoor_humidity') | float(0) | round(0) | int }}%",
          "color": "{% set t = states('sensor.indoor_temperature') | float(0) %}{{ 'blue' if t < 20 else 'green' if t <= 24 else 'amber' if t <= 26 else 'deep-orange' }}",
          "tap_action": {
            "action": "navigate",
            "navigation_path": "/lovelace/climate"
          },
          "icon_tap_action": {
            "action": "navigate",
            "navigation_path": "/lovelace/climate"
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "vertical": true,
          "grid_options": {
            "columns": 4
          },
          "entity": "alarm_control_panel.home",
          "primary": "Alarm",
          "icon": "{{ {'disarmed':'mdi:shield-outline','armed_home':'mdi:shield-home','armed_night':'mdi:shield-moon','armed_away':'mdi:shield-lock','arming':'mdi:shield-sync','pending':'mdi:shield-sync','triggered':'mdi:shield-alert'}.get(states('alarm_control_panel.home'), 'mdi:shield-off-outline') }}",
          "secondary": "{{ {'disarmed':'Disarmed','armed_home':'Armed home','armed_night':'Armed night','armed_away':'Armed away','arming':'Arming…','pending':'Pending…','triggered':'TRIGGERED'}.get(states('alarm_control_panel.home'), 'Unavailable') }}",
          "color": "{{ {'disarmed':'green','armed_home':'blue','armed_night':'indigo','armed_away':'red','arming':'amber','pending':'amber','triggered':'red'}.get(states('alarm_control_panel.home'), 'grey') }}",
          "tap_action": {

    {
      "type": "grid",
      "column_span": 2,
      "cards": [
        {
          "type": "heading",
          "heading": "Spot price",
          "icon": "mdi:cash-clock"
        },
        {
          "type": "custom:mushroom-template-card",
          "grid_options": {
            "columns": 12
          },
          "entity": "sensor.current_spot_electricity_price",
          "primary": "Electricity now",
          "icon": "mdi:transmission-tower",
          "secondary": "{{ states('sensor.current_spot_electricity_price') | float(0) | round(2) }} Kč/kWh · {{ states('sensor.current_spot_electricity_hour_order') }}{{ 'st' if states('sensor.current_spot_electricity_hour_order') == '1' else 'nd' if states('sensor.current_spot_electricity_hour_order') == '2' else 'rd' if states('sensor.current_spot_electricity_hour_order') == '3' else 'th' }} cheapest hour today",
          "color": "{% set p = states('sensor.current_spot_electricity_price') | float(-1) %}{% set lo = states('sensor.spot_cheapest_electricity_today') | float(-1) %}{% set hi = states('sensor.spot_most_expensive_electricity_today') | float(-1) %}{% if p < 0 or hi <= lo %}grey{% else %}{% set f = (p - lo) / (hi - lo) %}{{ 'green' if f < 0.25 else 'light-green' if f < 0.5 else 'amber' if f < 0.75 else 'deep-orange' }}{% endif %}",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          }
        },
        {
          "type": "custom:mini-graph-card",

{
  "title": "Energy",
  "path": "energy",
  "type": "sections",
  "icon": "mdi:lightning-bolt",
  "max_columns": 3,
  "badges": [
    {
      "type": "entity",
      "entity": "sensor.ac_power_total",
      "name": "AC load now",
      "show_state": true,
      "color": "green"
    },
    {
      "type": "entity",
      "entity": "sensor.socket_power_total",
      "name": "Socket load",
      "show_state": true,
      "color": "teal"
    },
    {
      "type": "entity",
      "entity": "sensor.volvo_xc40_charging_power",
      "name": "Car charging",
      "show_state": true,
      "color": "blue",

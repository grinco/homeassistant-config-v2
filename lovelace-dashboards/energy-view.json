{
  "title": "Energy",
  "path": "energy",
  "type": "sections",
  "icon": "mdi:lightning-bolt",
  "max_columns": 3,
  "badges": [
    {
      "type": "entity",
      "entity": "sensor.ac_power_total",
      "name": "AC load now",
      "show_state": true,
      "color": "green"
    },
    {
      "type": "entity",
      "entity": "sensor.socket_power_total",
      "name": "Socket load",
      "show_state": true,
      "color": "teal"
    },
    {
      "type": "entity",
      "entity": "sensor.current_spot_electricity_price",
      "name": "Spot now",
      "show_state": true,
      "color": "amber"
    },
    {
      "type": "entity",
      "entity": "sensor.volvo_xc40_charging_power",
      "name": "Car charging",
      "show_state": true,
      "color": "blue",
      "visibility": [
        {
          "condition": "numeric_state",
          "entity": "sensor.volvo_xc40_charging_power",
          "above": 0
        }
      ]
    }
  ],
  "sections": [
    {
      "type": "grid",
      "column_span": 2,
      "cards": [
        {
          "type": "heading",
          "heading": "Load now",
          "icon": "mdi:speedometer"
        },
        {
          "type": "custom:mini-graph-card",
          "entities": [
            {
              "entity": "sensor.ac_power_total",
              "name": "All air conditioners",
              "color": "#4caf50"
            },
            {
              "entity": "sensor.socket_power_total",
              "name": "All sockets",
              "color": "#00bcd4"
            }
          ],
          "icon": "mdi:lightning-bolt",
          "hours_to_show": 24,
          "points_per_hour": 4,
          "line_width": 2,
          "height": 140,
          "lower_bound": 0,
          "show": {
            "name": true,
            "icon": true,
            "state": true,
            "labels": true,
            "legend": false,
            "fill": "fade",
            "extrema": true
          },
          "grid_options": {
            "columns": 12,
            "rows": "auto"
          }
        },
        {
          "type": "heading",
          "heading": "Per air conditioner",
          "heading_style": "subtitle",
          "icon": "mdi:air-conditioner"
        },
        {
          "type": "tile",
          "entity": "sensor.living_room_livingroom_ac_power",
          "name": "Living room",
          "icon": "mdi:air-conditioner",
          "color": "orange",
          "grid_options": {
            "columns": 6
          },
          "features": [
            {
              "type": "bar-gauge",
              "min": 0,
              "max": 1500

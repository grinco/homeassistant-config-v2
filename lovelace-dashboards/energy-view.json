          "grid_options": {
            "columns": 12,
            "rows": "auto"
          }
        },
        {
          "type": "tile",
          "entity": "sensor.spot_cheapest_electricity_today",
          "name": "Cheapest today",
          "icon": "mdi:arrow-down-bold",
          "color": "green",
          "grid_options": {
            "columns": 6
          }
        },
        {
          "type": "tile",
          "entity": "sensor.spot_most_expensive_electricity_today",
          "name": "Dearest today",
          "icon": "mdi:arrow-up-bold",
          "color": "deep-orange",
          "grid_options": {
            "columns": 6
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "grid_options": {
            "columns": 12
          },
          "entity": "binary_sensor.spot_electricity_is_cheapest",
          "primary": "Cheapest block",
          "icon": "mdi:clock-check-outline",
          "secondary": "{% set s = state_attr('binary_sensor.spot_electricity_is_cheapest','Start hour') %}{% set e = state_attr('binary_sensor.spot_electricity_is_cheapest','End hour') %}{% if s is none %}—{% else %}{{ s }}:00–{{ e }}:00{{ ' · now' if is_state('binary_sensor.spot_electricity_is_cheapest','on') else '' }}{% endif %}",
          "color": "{{ 'green' if is_state('binary_sensor.spot_electricity_is_cheapest','on') else 'grey' }}",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          }
        },
        {
          "type": "heading",
          "heading": "Tomorrow",
          "heading_style": "subtitle",
          "icon": "mdi:calendar-arrow-right",
          "visibility": [
            {
              "condition": "state",
              "entity": "binary_sensor.spot_electricity_has_tomorrow_data",
              "state": "on"
            }
          ]
        },
        {
          "type": "tile",
          "entity": "sensor.spot_cheapest_electricity_tomorrow",
          "name": "Cheapest",
          "icon": "mdi:arrow-down-bold",
          "color": "green",

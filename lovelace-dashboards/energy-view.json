        "template": "\n{%- set pc = integration_entities('powercalc') -%}\n{%- set ns = namespace(s=[]) -%}\n{%- for p in states.sensor | selectattr('attributes.device_class','defined') | selectattr('attributes.device_class','eq','power') | map(attribute='entity_id') | reject('in', pc) | sort -%}\n{%- set d = device_id(p) -%}\n{%- if d -%}\n{%- set ents = device_entities(d) -%}\n{%- set sw = ents | select('match','switch\\.') | list -%}\n{%- if sw and not (ents | select('match','climate\\.') | list) -%}\n{%- set ml = sw | map('length') | min -%}\n{%- set main = sw | select('search', '^.{' ~ ml ~ '}$') | first -%}\n{%- set en = ents | select('match','sensor\\.') | reject('in', pc) | select('is_state_attr','device_class','energy') | list -%}\n{%- set ns.s = ns.s + [{'power': p, 'energy': en | first | default(''), 'switch': main, 'name': device_attr(d,'name_by_user') or device_attr(d,'name')}] -%}\n{%- endif -%}\n{%- endif -%}\n{%- endfor -%}\n{%- set ov = config.get('sockets', {}) -%}\n{%- set ord = namespace(l=[]) -%}{%- for k in ov.keys() -%}{%- set ord.l = ord.l + (ns.s | selectattr('power','eq',k) | list) -%}{%- endfor -%}\n{%- set ns.s = ord.l + (ns.s | rejectattr('power','in', ov.keys() | list) | list) -%}\n\n{%- set mains = ns.s | map(attribute='switch') | list -%}\n{%- set oo = config.get('outlets', {}) -%}\n{%- set out = namespace(l=[]) -%}\n{%- for s in states.switch | selectattr('attributes.device_class','defined') | selectattr('attributes.device_class','eq','outlet') | map(attribute='entity_id') | reject('in', mains) | sort -%}\n{%- set o = oo.get(s, {}) -%}\n{%- set out.l = out.l + [{'type': 'custom:button-card', 'template': 'vg_outlet', 'entity': s, 'name': o.get('name') or state_attr(s, 'friendly_name'), 'icon': o.get('icon') or 'mdi:power-plug-outline'}] -%}\n{%- endfor -%}\n{{ out.l }}"

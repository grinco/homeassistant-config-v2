          "name": "Spot electricity",
          "icon": "mdi:cash-clock",
          "hours_to_show": 24,
          "points_per_hour": 1,
          "line_width": 2,
          "height": 130,
          "aggregate_func": "max",
          "show": {
            "name": true,
            "icon": true,
            "state": true,
            "labels": true,
            "legend": false,
            "fill": "fade",
            "extrema": true

{
  "title": "Security",
  "path": "security",
  "type": "sections",
  "icon": "mdi:shield-home",
  "max_columns": 3,
  "badges": [],
  "sections": [
    {
      "type": "grid",
      "column_span": 1,
      "cards": [
        {
          "type": "heading",
          "heading": "Alarm",
          "icon": "mdi:shield-home"
        },
        {
          "type": "custom:alarmo-card",
          "entity": "alarm_control_panel.home",
          "name": "",
          "keep_keypad_visible": false,
          "button_scale_actions": 1,
          "button_scale_keypad": 1,
          "states": {},
          "show_messages": true,
          "show_ready_indicator": true,
          "show_bypassed_sensors": true,
          "use_code_dialog": false,
          "hide_keypad": false,
          "grid_options": {
            "columns": "full",
            "rows": "auto"
          }
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Sensors",
          "icon": "mdi:motion-sensor"
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "binary_sensor.0x0017880106495a81_occupancy",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Front door motion",
          "icon": "mdi:motion-sensor",
          "color": "#ffc107",
          "grid_options": {
            "columns": 12
          }
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "binary_sensor.shower_sink_leak_water_leak",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Shower sink leak",
          "icon": "mdi:water-alert",
          "color": "#f44336",
          "grid_options": {
            "columns": 12
          }
        },
        {
          "type": "heading",
          "heading": "Presence",
          "heading_style": "subtitle",
          "icon": "mdi:account-group"
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "person.vadim_grinco",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Vadim",
          "color": "#4caf50",
          "grid_options": {
            "columns": 4
          }
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "person.janka_grinco",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Janka",
          "color": "#4caf50",
          "grid_options": {
            "columns": 4
          }
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "person.kid1_grinco",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Kids room 1",
          "color": "#9c27b0",
          "grid_options": {
            "columns": 4
          }
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Front door camera",
          "icon": "mdi:cctv",
          "badges": [
            {
              "type": "entity",
              "entity": "sensor.home_door_battery",
              "name": "Battery",
              "show_state": true,
              "color": "green"
            },
            {
              "type": "entity",
              "entity": "binary_sensor.home_door_motion",
              "name": "PIR",
              "show_state": true,
              "color": "amber"
            }
          ]
        },
        {
          "type": "picture-entity",
          "entity": "image.home_door_last_motion_image",
          "name": "Last motion",
          "show_state": false,
          "show_name": false,
          "fit_mode": "contain",
          "grid_options": {
            "columns": "full",
            "rows": 6
          },
          "tap_action": {
            "action": "more-info"
          }
        },
        {
          "type": "markdown",
          "text_only": true,
          "content": "{% set i = states.image.home_door_last_motion_image %}{% if i %}**Last motion** — {{ as_timestamp(i.last_changed) | timestamp_custom('%-d %b, %H:%M') }} · {{ relative_time(i.last_changed) }} ago · {{ states('sensor.home_door_last_alarm_type_name') }}{% else %}No motion image yet.{% endif %}"
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "camera.home_door",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Live view",
          "icon": "mdi:cctv",
          "color": "#2196f3",
          "tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6
          }
        },
        {
          "type": "custom:button-card",
          "template": [
            "standard_btn_layout",
            "standard_btn_states"
          ],
          "entity": "binary_sensor.home_door_motion",
          "show_state": true,
          "show_name": true,
          "show_label": false,
          "show_last_changed": false,
          "name": "Camera PIR",
          "icon": "mdi:motion-sensor",
          "color": "#ffc107",
          "grid_options": {
            "columns": 6
          }
        }
      ],
      "background": {
        "color": "blue-grey",
        "opacity": 10
      }
    }
  ]
}

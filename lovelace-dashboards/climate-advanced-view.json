          "text_only": true,
          "content": "{% set rooms = [('Living room','input_datetime.climate_manual_until_living_room'),('Office','input_datetime.climate_manual_until_office'),('Bedroom','input_datetime.climate_manual_until_bedroom'),('Kids room 1','input_datetime.climate_manual_until_kid1'),('Kids room 2','input_datetime.climate_manual_until_kid2')] %}{% set ns = namespace(held=[]) %}{% for n, e in rooms %}{% set t = state_attr(e,'timestamp') %}{% if t and now().timestamp() < t %}{% set ns.held = ns.held + [n ~ ' (until ' ~ (t | timestamp_custom('%H:%M')) ~ ')'] %}{% endif %}{% endfor %}{% if ns.held %}✋ **Manual control: {{ ns.held | join(', ') }}** — the automation is keeping its hands off {{ 'that room' if ns.held | count == 1 else 'those rooms' }} until the hold expires.{% else %}No manual holds — the automation has control of all five rooms.{% endif %}"

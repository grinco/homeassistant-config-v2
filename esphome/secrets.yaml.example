# Copy to secrets.yaml in the ESPHome app's config directory and fill in.
# secrets.yaml itself is NEVER committed — this file records which keys the
# device configs reference, and nothing else.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# API encryption keys — one per device, base64, 32 bytes.
# Generate: openssl rand -base64 32
#
# These are not interchangeable and not optional. Changing a device's key means
# removing and re-adding that device in Home Assistant, so if you are restoring
# an existing device, use the key Home Assistant already has for it:
#   Settings -> Devices & Services -> ESPHome -> <device> -> the stored key.
geiger_api_key: "base64-32-bytes"
lr_bt_proxy_api_key: "base64-32-bytes"
hw_622_api_key: "base64-32-bytes"

# OTA passwords. Only hw-622 sets one. Changing it on a device that already
# has one needs the old password for the first flash after the change.
hw_622_ota_password: "any-string"
